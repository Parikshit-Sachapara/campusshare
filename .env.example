# Backend Environment Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campusshare
JWT_SECRET=supersecret-demo-jwt-key-change-in-production-32bytes
REFRESH_SECRET=supersecret-campusshare-refresh-key-32bytes-min
QR_SECRET=supersecret-campusshare-qr-verification-token-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Uploads & Storage (Local fallback vs Cloudinary)
STORAGE_MODE=local
UPLOAD_DIR=./uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Recommendation Engine (Optional)
LLM_API_KEY=

# CORS Settings
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://campusshare.vercel.app

# Frontend Environment Configuration
VITE_API_URL=http://localhost:8000
