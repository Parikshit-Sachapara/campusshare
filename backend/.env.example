# ====================================================================
# CampusShare Backend Environment Configuration
# ====================================================================

# PostgreSQL Connection (Neon or local PostgreSQL with btree_gist & pg_trgm)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campusshare

# Security & Cryptographic Tokens (Must be at least 32 characters in production)
JWT_SECRET=supersecret-campusshare-jwt-key-32bytes-min
REFRESH_SECRET=supersecret-campusshare-refresh-key-32bytes-min
QR_SECRET=supersecret-campusshare-qr-verification-token-key

# Token Lifespans
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed CORS Origins (comma-separated for multiple domains)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://campusshare.vercel.app

# Storage Mode (local or cloudinary)
STORAGE_MODE=local
UPLOAD_DIR=./uploads

# Cloudinary CDN Configuration (Optional - fallback to local storage if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Recommendation Engine (Optional - deterministic semantic matching if empty)
LLM_API_KEY=

